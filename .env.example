# Worker portal. Leave PORTAL_MODE unset, or as mock, to try the site with no accounts.
# Copy this file to .env.local. Never commit .env.local.
# Full meanings, formats and who creates each value: docs/go-live.md

PORTAL_MODE=mock

# First Thursday of the pay calendar. YYYY-MM-DD. Blank uses 2026-11-05.
PORTAL_PAY_ANCHOR=2026-11-05

# Neon Postgres connection string. Required when PORTAL_MODE=live.
# postgres:// or postgresql://. The portal_records table is created on the first live request.
DATABASE_URL=

# Notion integration. Database ids are 32 hex characters, hyphens optional.
NOTION_TOKEN=
NOTION_WORKERS_DB=
NOTION_PLACEMENTS_DB=
NOTION_TIMESHEETS_DB=
# Not written by the portal. Leave blank unless you want the id recorded.
NOTION_INDUCTION_DB=
# Not read by the portal.
NOTION_SITE_CONFIRMATIONS_DB=
NOTION_SHIFT_OFFERS_DB=
# Only for npm run portal:shift-offers -- --apply
NOTION_PARENT_PAGE_ID=
PORTAL_NOTION_ENV=test
CONFIRM_CREATE_SHIFT_OFFERS=

# Private Vercel Blob token, starting vercel_blob_rw_. Optional.
BLOB_READ_WRITE_TOKEN=

# Optional. Leave all three blank for email-only sign-in.
# SID: AC plus 32 hex characters. Auth token: 32 hex characters. From: +61…
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Resend. The key starts with re_. The from address is portal@msworkforce.au.
RESEND_API_KEY=
EMAIL_FROM=MS Workforce <portal@msworkforce.au>

# Admin sign-in email and authenticator secret (base32, 32 characters recommended).
ADMIN_EMAIL=hello@msworkforce.au
ADMIN_MOBILE=+61400000001
ADMIN_TOTP_SECRET=

# Each one is a different random string of at least 32 characters.
# PORTAL_ENCRYPTION_KEY is a passphrase. It is not a raw AES key.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PORTAL_SESSION_SECRET=
PORTAL_ENCRYPTION_KEY=
PORTAL_SIGNING_SECRET=
CRON_SECRET=

NEXT_PUBLIC_SITE_URL=https://www.msworkforce.au
