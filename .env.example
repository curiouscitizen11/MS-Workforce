# Worker portal. Leave PORTAL_MODE as mock to try the site with no accounts.
# Copy this file to .env.local. Never commit .env.local.

PORTAL_MODE=mock

# First Thursday of the pay calendar. Used for fortnight cut-off. Default is 2026-11-05.
PORTAL_PAY_ANCHOR=2026-11-05

# Neon Postgres. Only needed when PORTAL_MODE=live.
DATABASE_URL=

# Notion integration (a TEST copy of HQ, not the live databases).
NOTION_TOKEN=
NOTION_WORKERS_DB=
NOTION_PLACEMENTS_DB=
NOTION_TIMESHEETS_DB=
NOTION_INDUCTION_DB=
NOTION_SITE_CONFIRMATIONS_DB=
NOTION_SHIFT_OFFERS_DB=
NOTION_PARENT_PAGE_ID=
PORTAL_NOTION_ENV=test
CONFIRM_CREATE_SHIFT_OFFERS=

# Private Vercel Blob store for ticket and ID photos.
BLOB_READ_WRITE_TOKEN=

# Twilio SMS login codes.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Email (Resend): magic links, timesheet confirmations, ticket reminders.
RESEND_API_KEY=
EMAIL_FROM=

# Marek's admin login.
ADMIN_EMAIL=hello@msworkforce.au
ADMIN_MOBILE=+61400000001
ADMIN_TOTP_SECRET=

# Long random strings. Generate a new one for each. Do not reuse these examples.
PORTAL_SESSION_SECRET=
PORTAL_ENCRYPTION_KEY=
PORTAL_SIGNING_SECRET=
CRON_SECRET=

NEXT_PUBLIC_SITE_URL=https://www.msworkforce.au
